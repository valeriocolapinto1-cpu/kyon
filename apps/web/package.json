{
  "name": "@kyon/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:worker": "opennextjs-cloudflare build && opennextjs-cloudflare populateCache local",
    "preview": "opennextjs-cloudflare preview",
    "typecheck": "tsc -p tsconfig.json",
    "db:generate": "drizzle-kit generate --name",
    "db:migrate:local": "wrangler d1 migrations apply kyon-db --local --persist-to ../../.wrangler/state"
  },
  "dependencies": {
    "@kyon/core": "workspace:*",
    "@opennextjs/cloudflare": "1.20.13",
    "drizzle-orm": "0.45.4",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261026.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint-config-next": "16.4.3",
    "typescript": "6.0.3",
    "wrangler": "4.152.0"
  }
}
