{
  "name": "@kyon/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:worker": "opennextjs-cloudflare build && opennextjs-cloudflare populateCache local",
    "preview": "opennextjs-cloudflare preview",
    "typecheck": "tsc -p tsconfig.json",
    "db:generate": "drizzle-kit generate --name",
    "db:migrate:local": "wrangler d1 migrations apply kyon-db --local --persist-to ../../.wrangler/state"
  },
  "dependencies": {
    "@kyon/core": "workspace:*",
    "@kyon/realtime": "workspace:*",
    "@opennextjs/cloudflare": "1.20.13",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-radio-group": "1.5.1",
    "@radix-ui/react-slider": "1.6.1",
    "@radix-ui/react-switch": "1.4.1",
    "@radix-ui/react-toast": "1.3.1",
    "@tailwindcss/postcss": "4.3.3",
    "@tanstack/react-query": "5.105.0",
    "better-auth": "1.7.13",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.14",
    "lucide-react": "1.61.0",
    "motion": "14.6.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261026.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint-config-next": "16.4.3",
    "typescript": "6.0.3",
    "wrangler": "4.152.0"
  }
}
